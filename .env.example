# Postgres connection string for the insights database.
# Dedicated DB — do NOT point this at the clear-api production database.
# Local dev: spin up a Postgres on localhost:5432 or use the shared dev DB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clear_pipeline_insights

# Shared bearer token. The pipeline (and local-classifier script) must send
# this as `Authorization: Bearer $INSIGHTS_INGEST_TOKEN` on /api/runs and /api/calls.
# Generate one with: openssl rand -hex 32
INSIGHTS_INGEST_TOKEN=replace-me

# --- Auth (Better Auth) ---
# Auth tables (user, session, account, verification) live in the same DB as
# the insights data — see DATABASE_URL above.
# Server-side secret used to sign session cookies and magic-link tokens.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me
# Public origin of this app — magic links are built relative to this.
BETTER_AUTH_URL=http://localhost:3000

# --- Magic-link delivery ---
# When unset, sendMagicLink logs the link to the server console (dev only).
# When set, magic links are sent via Postmark. POSTMARK_FROM must be a
# verified sender signature or a verified-domain address in your Postmark
# account, otherwise the API rejects with 422.
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM=no-reply@yourdomain.com

# --- Phase 3b: clear-api GraphQL read access ---
# Used by /review/events to import clusters for review.
# Leave blank if you're not running Phase 3b — the rest of the app works without it.
CLEAR_API_URL=http://localhost:4000/graphql
# sk_live_... from clear-api createApiKey mutation. See bead clear-pipeline-insights-gb6.
CLEAR_API_TOKEN=
# Optional. Omit when the service user has role='admin' (the default for insights).
CLEAR_API_TEAM_ID=
